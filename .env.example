# Plantilla de configuración. Crea tu .env con:  make env
# - Los valores __GENERATE__ se reemplazan por secretos aleatorios.
# - Sin comillas ni espacios en los valores.

COMPOSE_PROJECT_NAME=api

# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_DB=api
POSTGRES_USER=api
POSTGRES_PASSWORD=__GENERATE__
# Puerto publicado en 127.0.0.1 (solo docker-compose.dev.yml); 5433 para no chocar con otro postgres local
POSTGRES_HOST_PORT=5433

# ── API ───────────────────────────────────────────────────
# Puerto dentro del contenedor
API_PORT=8080
# Puerto publicado en 127.0.0.1 (solo docker-compose.dev.yml); el proxy /api del frontend apunta aquí
API_HOST_PORT=8082
API_LOG_LEVEL=info
POSTGRES_SSLMODE=disable
# Deben coincidir con JWT_ISSUER/JWT_AUDIENCE del repo auth
JWT_ISSUER=auth-svc
JWT_AUDIENCE=auth-dashboard-api
# Tamaño máximo del cuerpo de una petición (bytes)
MAX_BODY_BYTES=65536
# Límites de un item (en caracteres) y tamaño máximo del listado
ITEM_TITLE_MAX=120
ITEM_DESCRIPTION_MAX=1000
ITEMS_PAGE_LIMIT=100

# ── Red compartida con los repos auth y frontend (mismo valor en los tres) ──
SHARED_NETWORK=practica
SHARED_NETWORK_SUBNET=172.30.0.0/24
